#!/usr/bin/env python3
"""Run a single bounded gateway; TLS/public ingress belongs to the deployment proxy."""
import argparse
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
python = root / '.venv/bin/python'
if Path(sys.prefix).resolve() != (root / '.venv').resolve():
    if not python.is_file():
        raise SystemExit('Install service: uv venv .venv && uv pip sync --python .venv/bin/python service/requirements.lock --require-hashes')
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
p = argparse.ArgumentParser()
p.add_argument('--host', default='127.0.0.1')
p.add_argument('--port', type=int, default=8091)
a = p.parse_args()
if a.host not in ('127.0.0.1', '::1') and len(os.environ.get('JAX_SERVICE_TOKEN', '')) < 32:
    p.error('non-loopback binding requires JAX_SERVICE_TOKEN of at least 32 characters')
if not 1 <= a.port <= 65535:
    p.error('port must be 1..65535')
sys.path.insert(0, str(root))
import uvicorn
uvicorn.run('service.app:create_app', factory=True, host=a.host, port=a.port, workers=1,
            loop='asyncio', http='h11', ws='none', proxy_headers=False, access_log=False,
            limit_concurrency=32, backlog=32, timeout_keep_alive=5, timeout_graceful_shutdown=130,
            h11_max_incomplete_event_size=16384, server_header=False, date_header=False)
